{
  "name": "antigravity-mcp",
  "version": "0.1.0",
  "description": "MCP server for the Google Antigravity CLI (agy) headless mode; defers model, effort and timeout to the CLI unless overridden",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "type": "module",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  },
  "private": true,
  "bin": {
    "antigravity-mcp": "dist/index.js"
  },
  "engines": {
    "node": ">=20"
  }
}
